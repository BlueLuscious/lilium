{
  "name": "@lilium/component",
  "version": "0.1.0",
  "description": "Headless component definitions and runtime for Lilium.",
  "author": "BlueLuscious",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "node ../../tooling/cli/clean-package-distribution.mjs",
    "test": "pnpm --filter @lilium/core run build && pnpm run test:types && pnpm run test:runtime && pnpm run test:package",
    "test:package": "pnpm run build && node --test tests/package/**/*.test.mjs",
    "test:runtime": "tsx --test tests/runtime/**/*.test.ts",
    "test:types": "tsc -p tsconfig.test.json",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@lilium/core": "workspace:*"
  },
  "keywords": []
}
