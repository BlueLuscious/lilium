{
  "name": "@lilium/compiler",
  "version": "0.1.0",
  "description": "Pure deterministic compiler from Lily source to public Lilium template modules.",
  "author": "BlueLuscious",
  "license": "ISC",
  "homepage": "https://github.com/BlueLuscious/lilium/tree/master/docs/en/packages/compiler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/lilium.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/BlueLuscious/lilium/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "node ../../tooling/cli/clean-package-distribution.mjs",
    "test": "pnpm run build && pnpm run test:types",
    "test:types": "tsc -p tsconfig.test.json",
    "watch": "tsc -w"
  },
  "keywords": [
    "compiler",
    "lilium",
    "lily",
    "source-to-source",
    "typescript"
  ]
}
