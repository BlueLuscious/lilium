{
  "name": "@lilium/compiler",
  "version": "0.1.0",
  "description": "Pure deterministic compiler from Lily source to public Lilium template modules.",
  "author": "BlueLuscious",
  "license": "ISC",
  "homepage": "https://github.com/BlueLuscious/lilium/tree/master/docs/en/packages/compiler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/lilium.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/BlueLuscious/lilium/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "node ../../tooling/cli/clean-package-distribution.mjs",
    "test": "pnpm --filter @lilium/core run build && pnpm --filter @lilium/component run build && pnpm --filter @lilium/template run build && pnpm --filter @lilium/renderer run build && pnpm --filter @lilium/renderer-console run build && pnpm run build && pnpm run test:types && pnpm run test:generated && pnpm run test:runtime && pnpm run test:package",
    "test:generated": "tsc -p tests/conformance/tsconfig.json",
    "test:package": "node --test tests/package/**/*.test.mjs",
    "test:runtime": "tsx --test tests/runtime/**/*.test.ts",
    "test:types": "tsc -p tsconfig.test.json",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@lilium/component": "workspace:*",
    "@lilium/core": "workspace:*",
    "@lilium/renderer": "workspace:*",
    "@lilium/renderer-console": "workspace:*",
    "@lilium/template": "workspace:*"
  },
  "keywords": [
    "compiler",
    "lilium",
    "lily",
    "source-to-source",
    "typescript"
  ]
}
