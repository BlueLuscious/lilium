{
  "name": "lilium",
  "description": "Target-independent frontend framework built around fine-grained reactivity and explicit ownership.",
  "private": true,
  "author": "BlueLuscious",
  "license": "ISC",
  "homepage": "https://github.com/BlueLuscious/lilium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/lilium.git"
  },
  "bugs": {
    "url": "https://github.com/BlueLuscious/lilium/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.17.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "build:component": "pnpm --filter @lilium/component... run build",
    "build:compiler": "pnpm --filter @lilium/compiler run build",
    "build:core": "pnpm --filter @lilium/core run build",
    "build:renderer": "pnpm --filter @lilium/renderer... run build",
    "build:template": "pnpm --filter @lilium/template... run build",
    "check": "pnpm run check:code && pnpm run check:jsdoc && pnpm run check:docs && pnpm run check:architecture",
    "check:architecture": "node tooling/cli/check-architecture.mjs",
    "check:code": "biome check .",
    "check:docs": "node tooling/cli/check-documentation-links.mjs",
    "check:jsdoc": "node tooling/cli/check-jsdoc.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "pnpm run build && pnpm run test:tooling && pnpm run test:types && pnpm run test:runtime && pnpm run test:package",
    "test:package": "pnpm --recursive --if-present run test:package",
    "test:runtime": "pnpm --recursive --if-present run test:runtime",
    "test:tooling": "node --test tests/tooling/**/*.test.mjs",
    "test:types": "pnpm --recursive --if-present run test:types",
    "verify": "pnpm run check && pnpm run test",
    "watch:component": "pnpm --filter @lilium/component run watch",
    "watch:compiler": "pnpm --filter @lilium/compiler run watch",
    "watch:core": "pnpm --filter @lilium/core run watch",
    "watch:renderer": "pnpm --filter @lilium/renderer run watch",
    "watch:template": "pnpm --filter @lilium/template run watch"
  },
  "keywords": [
    "frontend",
    "framework",
    "reactivity",
    "typescript"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^24.13.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
