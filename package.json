{
  "name": "lilium",
  "description": "",
  "private": true,
  "author": "BlueLuscious",
  "license": "ISC",
  "packageManager": "pnpm@10.17.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:component": "pnpm --filter @lilium/component... run build",
    "build:core": "pnpm --filter @lilium/core run build",
    "check": "pnpm run check:code && pnpm run check:jsdoc && pnpm run check:docs && pnpm run check:architecture",
    "check:architecture": "node tooling/cli/check-architecture.mjs",
    "check:code": "biome check .",
    "check:docs": "node tooling/cli/check-documentation-links.mjs",
    "check:jsdoc": "node tooling/cli/check-jsdoc.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test:tooling": "node --test tests/tooling/**/*.test.mjs",
    "watch:component": "pnpm --filter @lilium/component run watch",
    "watch:core": "pnpm --filter @lilium/core run watch"
  },
  "keywords": [],
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
